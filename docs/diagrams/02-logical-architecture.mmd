flowchart TB
    subgraph Identify
        E[Evidence ingestion]
        T[Threat registry]
        C[Coverage and confidence]
        E --> T --> C
    end
    subgraph Generate
        SC[Scenario compiler]
        CP[Campaign planner]
        SIM[Stateful simulator]
        ORA[Hidden validity oracle]
        SC --> CP --> SIM
        ORA --> CP
    end
    subgraph Defend
        TP[Agentic trust plane]
        R[Rules]
        M[GBDT risk model]
        G[Temporal and graph evidence]
        P[Action and case policy]
        TP --> R --> M --> G --> P
    end
    subgraph Assure
        EV[Independent evaluator]
        REP[Evidence report]
        GOV[Human promotion gate]
        EV --> REP --> GOV
    end
    C --> SC
    SIM --> TP
    P --> EV
    EV -. bounded feedback .-> CP

