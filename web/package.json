{
  "name": "apar-assurance-console",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "build": "tsc -b && vite build",
    "dev": "vite --host 127.0.0.1",
    "e2e": "playwright test",
    "lint": "eslint . --max-warnings 0",
